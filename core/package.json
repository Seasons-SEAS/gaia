{
  "name": "gaia-core",
  "version": "0.1.0",
  "description": "GAIA 2.0 Core: Seasons' official AI agent (guards, judgment, brain, verifier, typed stream)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-vars.mjs && node scripts/build-canon.mjs && node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "node evals/run.mjs",
    "deploy": "wrangler deploy",
    "canon": "node scripts/build-canon.mjs",
    "canon:check": "node scripts/build-canon.mjs --check",
    "library": "tsx scripts/extract-site-pages.mts && node scripts/build-library.mjs",
    "build:vercel": "node scripts/build-canon.mjs && node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@noble/curves": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@vercel/functions": "^3.9.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
