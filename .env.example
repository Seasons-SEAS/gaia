# Copy to .env.local (gitignored) at the repository root.
# core/scripts/dev-vars.mjs copies these into core/.dev.vars for `wrangler dev`.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional: Jev shadow judge through the Vercel AI Gateway (eval requests only)
AI_GATEWAY_API_KEY=
# Local dev always reads Solana through the Node relay (core/scripts/dev.mjs);
# to point the relay at a paid RPC, export DEV_RPC_UPSTREAM=<url> in your shell.
# In production SOLANA_RPC_URL is a Cloudflare secret (see docs/RUNBOOK.md).
# Optional, stage dev only: talk to a remote Core instead of ../core on :8788
# GAIA_CORE_URL=https://your-gaia-core.example.com
